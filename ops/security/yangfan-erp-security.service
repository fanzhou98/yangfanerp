[Unit]
Description=Read-only ERP security and backup checks
After=yangfan-erp.service nginx.service

[Service]
Type=oneshot
User=yangfan-erp
Group=yangfan-erp
ExecStart=/usr/bin/python3 /opt/yangfan-erp-security/check.py
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
TimeoutStartSec=45
StandardOutput=journal
StandardError=journal
SyslogIdentifier=yangfan-erp-security
