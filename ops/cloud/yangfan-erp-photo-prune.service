[Unit]
Description=Monthly driver photo archive and retention cleanup
After=yangfan-erp.service

[Service]
Type=oneshot
User=yangfan-erp
Group=yangfan-erp
WorkingDirectory=/srv/yangfan-erp/current
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 ops/erp_ops.py photo-prune --database /var/lib/yangfan-erp/erp.db --photos /var/lib/yangfan-erp/driver-photos --archive /var/lib/yangfan-erp/photo-archives --apply
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/yangfan-erp
