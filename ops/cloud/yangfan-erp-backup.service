[Unit]
Description=Consistent hourly ERP backup
After=yangfan-erp.service

[Service]
Type=oneshot
User=yangfan-erp
Group=yangfan-erp
WorkingDirectory=/srv/yangfan-erp/current
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 ops/erp_ops.py backup --database /var/lib/yangfan-erp/erp.db --destination /var/lib/yangfan-erp/backups
ExecStart=/usr/bin/python3 ops/erp_ops.py prune --directory /var/lib/yangfan-erp/backups
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/yangfan-erp
