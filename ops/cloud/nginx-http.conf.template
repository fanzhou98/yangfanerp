server {
    listen 80 default_server;
    server_name _;
    server_tokens off;
    location / { return 404; }
}
server {
    listen 80;
    server_name __HOST__;
    server_tokens off;
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/yangfan-acme;
        default_type text/plain;
    }
    location / { return 503; }
}
